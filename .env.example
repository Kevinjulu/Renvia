# Database
DATABASE_URL=

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI providers
FAL_KEY=
# mock (default, free placeholder results) | dev (cheapest model) | prod
FAL_MODE=mock
# Hard cap on total estimated fal spend in USD; unset/0 blocks paid renders
FAL_BUDGET_USD=3
# Optional fal key on the BILLING preset: shows the real fal balance in admin.
FAL_ADMIN_KEY=

# Storage (Cloudflare R2, S3-compatible). Older NEON_STORAGE_* names are still read as a fallback.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Signed browser links for images stored in R2. Use a long random value.
STORAGE_URL_SIGNING_SECRET=

# API callers and scheduled render recovery
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CRON_SECRET=

# PayPal (API project only, never VITE_*). Leave blank until you have credentials: PayPal checkout
# stays disabled and webhooks answer 503 while any of the first three is empty.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook ID from the PayPal dashboard, not the client ID.
PAYPAL_WEBHOOK_ID=
# sandbox for the PayPal sandbox app; omit for live.
PAYPAL_ENV=sandbox

# Paystack: card and M-Pesa (API project only). Leave blank to keep both off. The secret key also
# verifies Paystack webhooks, so there is no separate webhook secret.
PAYSTACK_SECRET_KEY=
# Kenyan shillings per US dollar for Paystack charges, e.g. 129. M-Pesa stays off until set.
PAYSTACK_KES_PER_USD=
# KES (default) or USD, if USD card payments are enabled on your Paystack account.
PAYSTACK_CARD_CURRENCY=
# Optional: where the Enterprise "Contact us" on the billing page sends people.
SALES_CONTACT_EMAIL=

# Optional: HTTPS endpoint for operational incident notifications.
OPS_NOTIFICATION_WEBHOOK_URL=

# Free-credit checks (API project only). SECURITY_HASH_KEY: 32+ random characters for the keyed
# hashes of browser ids and network prefixes; nothing is recorded without it (and without the
# Settings switch). TRUSTED_IP_HEADER: the header your host sets to the client IP (Vercel:
# x-real-ip). TURNSTILE_SECRET_KEY: Cloudflare Turnstile secret for the human check.
SECURITY_HASH_KEY=
TRUSTED_IP_HEADER=x-real-ip
TURNSTILE_SECRET_KEY=
# Studio (public): the matching Turnstile site key.
VITE_TURNSTILE_SITE_KEY=

# Local-only Postgres for `pnpm --filter @renvia/api test` (see apps/api/test/README.md).
# The tests wipe this database and refuse non-local hosts.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/renvia_test
