# Database
DATABASE_URL=

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI providers
FAL_KEY=
# mock (default, free placeholder results) | dev (cheapest model) | prod
FAL_MODE=mock
# Hard cap on total estimated fal spend in USD; unset/0 blocks paid renders
FAL_BUDGET_USD=3

# Storage (Neon Object Storage)
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=
NEON_STORAGE_REGION=

# Signed browser links for images stored in Neon Object Storage. Use a long random value.
STORAGE_URL_SIGNING_SECRET=

# API callers and scheduled render recovery
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CRON_SECRET=
