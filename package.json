{
  "name": "renvia",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @renvia/db db:generate",
    "db:migrate": "pnpm --filter @renvia/db db:migrate"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "^5.7.2"
  }
}
